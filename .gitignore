#      Common .gitignore Configuration      #
#############################################
#                                           #
# Based on the gist provided by             #
# GitHub at:                                #
# https://gist.github.com/octocat/9257657   #
#                                           #
# and also modified by                      #
# MrKoby07                                  #
# for personal use                          #
# Homepage: https://master3307.org/         #
#############################################

# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# It's better to unpack these files and commit the raw source.
# Git has its own built in compression methods.
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Output Folders #
##################
bin/
obj/
out/
build/

# Logs and databases #
######################
*.log
*.sql
*.sqlite

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Backup or temporary files #
#############################
*.pyo
*.pyc
*~
*.bak

# Code editors #
################
.vscode/
*.code-workspace
.idea/
*.sublime-workspace
*.sublime-project
*.swo
*.swx
*.swp
.session
\#*\#

# Python tooling #
##################
.venv/
venv/
.env
.env.*

# Vite / React / pnpm #
#######################
node_modules/
dist/
dist-ssr/
coverage/
*.local
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.oxlint

# Obsidian #
############
*.obsidian/

# MkDocs #
##########
/site
.cache/
